# Variables de entorno utilizadas por TalentBot / NOVA AI
# Copia este archivo como `.env` y completa los valores según tu entorno.
# No incluyas credenciales reales en el repositorio.

# Clave secreta utilizada por los componentes de autenticación/JWT del backend FastAPI (capa secundaria).
# Debe ser una cadena aleatoria y privada.
SECRET_KEY=cambia_esta_clave_por_una_segura

# Token del bot de Telegram (proporcionado por @BotFather) para ejecutar NOVA AI.
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
